{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "contractVersion": "1.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "bpm"
      ],
      "properties": {
        "kind": {
          "const": "set_tempo"
        },
        "bpm": {
          "type": "integer",
          "minimum": 10,
          "maximum": 999
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trackId",
        "newName"
      ],
      "properties": {
        "kind": {
          "const": "rename_track"
        },
        "trackId": {
          "type": "string",
          "minLength": 1
        },
        "newName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trackId",
        "muted"
      ],
      "properties": {
        "kind": {
          "const": "set_track_mute"
        },
        "trackId": {
          "type": "string",
          "minLength": 1
        },
        "muted": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "parameterId",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "set_parameter"
        },
        "parameterId": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trackId",
        "clientRef",
        "positionTicks",
        "lengthTicks"
      ],
      "properties": {
        "kind": {
          "const": "create_midi_clip"
        },
        "trackId": {
          "type": "string",
          "minLength": 1
        },
        "clientRef": {
          "type": "string",
          "minLength": 1
        },
        "positionTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "lengthTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clip",
        "notes"
      ],
      "properties": {
        "kind": {
          "const": "add_notes"
        },
        "clip": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "clipId"
              ],
              "properties": {
                "clipId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "clientRef"
              ],
              "properties": {
                "clientRef": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": [
              "positionTicks",
              "lengthTicks",
              "midiKey"
            ],
            "additionalProperties": false,
            "properties": {
              "noteRef": {
                "type": "string",
                "minLength": 1
              },
              "positionTicks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "lengthTicks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "midiKey": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "volumePercent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200
              },
              "pan": {
                "type": "integer",
                "minimum": -100,
                "maximum": 100
              },
              "noteType": {
                "enum": [
                  "regular",
                  "step"
                ]
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clipId",
        "notes"
      ],
      "properties": {
        "kind": {
          "const": "update_notes"
        },
        "clipId": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": [
              "positionTicks",
              "lengthTicks",
              "midiKey",
              "noteRef"
            ],
            "additionalProperties": false,
            "properties": {
              "noteRef": {
                "type": "string",
                "minLength": 1
              },
              "positionTicks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "lengthTicks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "midiKey": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "volumePercent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200
              },
              "pan": {
                "type": "integer",
                "minimum": -100,
                "maximum": 100
              },
              "noteType": {
                "enum": [
                  "regular",
                  "step"
                ]
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clipId",
        "noteRefs"
      ],
      "properties": {
        "kind": {
          "const": "remove_notes"
        },
        "clipId": {
          "type": "string",
          "minLength": 1
        },
        "noteRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clipId",
        "semitones"
      ],
      "properties": {
        "kind": {
          "const": "transpose_notes"
        },
        "clipId": {
          "type": "string",
          "minLength": 1
        },
        "noteRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semitones": {
          "type": "integer",
          "minimum": -127,
          "maximum": 127,
          "not": {
            "const": 0
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clipId",
        "positionTicks"
      ],
      "properties": {
        "kind": {
          "const": "move_clip"
        },
        "clipId": {
          "type": "string",
          "minLength": 1
        },
        "positionTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clipId",
        "lengthTicks"
      ],
      "properties": {
        "kind": {
          "const": "resize_clip"
        },
        "clipId": {
          "type": "string",
          "minLength": 1
        },
        "lengthTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clipId",
        "clientRef",
        "positionTicks"
      ],
      "properties": {
        "kind": {
          "const": "duplicate_clip"
        },
        "clipId": {
          "type": "string",
          "minLength": 1
        },
        "clientRef": {
          "type": "string",
          "minLength": 1
        },
        "positionTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clipId"
      ],
      "properties": {
        "kind": {
          "const": "delete_clip"
        },
        "clipId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trackId"
      ],
      "properties": {
        "kind": {
          "const": "delete_track"
        },
        "trackId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "create_mixer_channel"
        },
        "clientRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fromChannelId",
        "toChannelId",
        "amount"
      ],
      "properties": {
        "kind": {
          "const": "set_mixer_send"
        },
        "fromChannelId": {
          "type": "string",
          "minLength": 1
        },
        "toChannelId": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trackId",
        "channelId"
      ],
      "properties": {
        "kind": {
          "const": "assign_mixer_channel"
        },
        "trackId": {
          "type": "string",
          "minLength": 1
        },
        "channelId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "patternId",
        "positionTicks",
        "lengthTicks"
      ],
      "properties": {
        "kind": {
          "const": "assign_pattern"
        },
        "patternId": {
          "type": "string",
          "minLength": 1
        },
        "clientRef": {
          "type": "string",
          "minLength": 1
        },
        "positionTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "lengthTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clipId",
        "steps"
      ],
      "properties": {
        "kind": {
          "const": "set_pattern_steps"
        },
        "clipId": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": [
              "stepIndex",
              "enabled"
            ],
            "additionalProperties": false,
            "properties": {
              "stepIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "parameterId",
        "points"
      ],
      "properties": {
        "kind": {
          "const": "set_automation_points"
        },
        "clipId": {
          "type": "string",
          "minLength": 1
        },
        "clientRef": {
          "type": "string",
          "minLength": 1
        },
        "positionTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "lengthTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "parameterId": {
          "type": "string",
          "minLength": 1
        },
        "interpolation": {
          "enum": [
            "linear",
            "discrete"
          ]
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": [
              "positionTicks",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "positionTicks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "value": {
                "type": "number"
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "type": "object",
          "required": [
            "clipId"
          ],
          "properties": {
            "clientRef": {
              "not": {}
            },
            "positionTicks": {
              "not": {}
            },
            "lengthTicks": {
              "not": {}
            }
          }
        },
        {
          "type": "object",
          "required": [
            "clientRef",
            "positionTicks",
            "lengthTicks"
          ],
          "properties": {
            "clipId": {
              "not": {}
            }
          }
        }
      ]
    }
  ]
}
