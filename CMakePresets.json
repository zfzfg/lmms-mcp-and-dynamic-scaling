{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-qt6-msvc-v145",
      "displayName": "Windows reference: Qt 6.8.3, MSVC >= 19.51 (v145), x64",
      "description": "Windows toolchain matching the compiler requirement in DetectMachine.cmake. Set LMMS_QT6_PREFIX and LMMS_DEPS_PREFIX to the Qt and dependency prefixes.",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "v145",
      "binaryDir": "${sourceDir}/build/reference-qt6",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{LMMS_QT6_PREFIX};$env{LMMS_DEPS_PREFIX}",
        "BUILD_TESTING": "ON",
        "WANT_QT6": "ON",
        "WANT_MCP": "ON"
      }
    },
    {
      "name": "windows-qt6-msvc-v145-no-mcp",
      "displayName": "Windows reference without MCP",
      "inherits": "windows-qt6-msvc-v145",
      "binaryDir": "${sourceDir}/build/reference-qt6-no-mcp",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{LMMS_QT6_PREFIX};$env{LMMS_DEPS_PREFIX}",
        "BUILD_TESTING": "ON",
        "WANT_QT6": "ON",
        "WANT_MCP": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-qt6-release",
      "configurePreset": "windows-qt6-msvc-v145",
      "configuration": "Release"
    },
    {
      "name": "windows-qt6-release-no-mcp",
      "configurePreset": "windows-qt6-msvc-v145-no-mcp",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-qt6-release",
      "configurePreset": "windows-qt6-msvc-v145",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
